# ─────────────────────────────────────────────────────────────────────────────
# Markdown Studio - exemplo de configuração
# Copie para `.env` e ajuste. NUNCA versione o arquivo `.env` real.
# ─────────────────────────────────────────────────────────────────────────────

# Ambiente: development | production | testing
FLASK_ENV=development

# OBRIGATÓRIO em produção. Gere uma chave nova com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-aleatoriamente

# Nome exibido na interface (também editável em Configurações).
APP_NAME=Markdown Studio

# ── Servidor ────────────────────────────────────────────────────────────────
# A aplicação NÃO tem login. Mantenha 127.0.0.1 salvo se souber o que está
# fazendo - veja "Cuidados para acesso por rede local" no README.
HOST=127.0.0.1
PORT=5000

# ── Banco de dados ──────────────────────────────────────────────────────────
# Padrão: SQLite em instance/app.db
# DATABASE_URL=sqlite:///C:/caminho/absoluto/app.db

# ── Limites ─────────────────────────────────────────────────────────────────
# Importação de .md
MAX_UPLOAD_MB=8
MAX_MARKDOWN_MB=2

# Importação em massa: vários .md de uma vez, ou um .zip com o acervo inteiro.
MAX_BULK_IMPORT_MB=64

# Envios feitos de dentro do editor, por tipo de conteúdo.
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=100
MEDIA_MAX_FILE_MB=50

DOCUMENTS_PER_PAGE=12
VERSIONS_PER_PAGE=20
READING_WPM=200

# ── PDF ─────────────────────────────────────────────────────────────────────
# auto | weasyprint | xhtml2pdf
# "auto" usa WeasyPrint quando as bibliotecas nativas estão presentes e cai
# para xhtml2pdf automaticamente quando não estão.
PDF_ENGINE=auto

# Imagens remotas nunca são baixadas durante a geração do PDF (proteção contra
# SSRF). Mantenha desativado a menos que entenda o risco.
PDF_ALLOW_REMOTE_IMAGES=false

# ── Arquivos ────────────────────────────────────────────────────────────────
# Padrão: instance/backups, instance/exports e instance/uploads
# BACKUP_DIR=C:/Users/voce/Documents/MarkdownStudioBackups
# EXPORT_DIR=
# UPLOAD_DIR=   # imagens, GIFs e vídeos enviados pelo editor

# ── Cookies ─────────────────────────────────────────────────────────────────
# Ative apenas se servir a aplicação por HTTPS.
SESSION_COOKIE_SECURE=false
